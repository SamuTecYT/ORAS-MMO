# Copia este archivo como ".env" (git lo ignora) y ajústalo. / Copy to ".env" (git-ignored) and edit.

# --- Servidor del MMO / MMO relay ---
# Puerto TCP. Si no es 9000, los jugadores ponen "IP:puerto" en mmo_server.txt.
PORT=9000
# Jugadores por sala (el plugin admite 12 como máximo)
ORAS_MAX_PLAYERS=12
# Segundos sin paquetes antes de liberar el sitio
ORAS_IDLE_TIMEOUT=60
# Límites contra saturación / anti-flood limits
ORAS_MAX_CLIENTS=300
ORAS_MAX_PER_IP=16
# Jugadores de una misma IP en una sala / players from one IP in one room
ORAS_MAX_PER_IP_ROOM=4
# Códigos de sala distintos que puede probar una IP en la ventana (s) / room codes one IP may try per window (s)
ORAS_ROOM_TRIES=5
ORAS_ROOM_TRIES_WINDOW=600
ORAS_MAX_ROOMS=100
ORAS_RANK_MAX_ROOMS=200
# Paquetes por segundo de cada jugador (el plugin manda ~30) y ráfaga / per-player packets per second and burst
ORAS_MAX_PPS=120
ORAS_BURST=240
# Servidor privado: solo estas salas (separadas por comas). Vacío = cualquiera.
# Private server: only these rooms (comma separated). Empty = any room.
ORAS_ROOMS=

# --- Sala de Azahar (opcional, perfil "azahar-room") / Azahar room (optional) ---
AZAHAR_ROOM_NAME=Pokemon ORAS MMO
AZAHAR_ROOM_DESC=Combates e intercambios / Battles and trades
AZAHAR_ROOM_MAX_MEMBERS=16
AZAHAR_ROOM_PASSWORD=cambia-esta-clave
